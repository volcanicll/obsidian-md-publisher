{
  "name": "obsidian-md-publisher",
  "version": "1.2.1",
  "description": "One-click publish Markdown notes to WeChat Official Account.",
  "main": "main.js",
  "scripts": {
    "dev": "bun run esbuild.config.mjs",
    "build": "bun run esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "version": "bun run .agent/skills/obsidian-version-manager/scripts/version_bump.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "markdown",
    "wechat",
    "wechat-official-account"
  ],
  "author": "volcanic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volcanicll/obsidian-md-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/volcanicll/obsidian-md-publisher/issues"
  },
  "homepage": "https://github.com/volcanicll/obsidian-md-publisher#readme",
  "devDependencies": {
    "@eslint-community/eslint-utils": "^4.9.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@typescript-eslint/utils": "^8.58.1",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "juice": "^11.1.0",
    "katex": "^0.16.27",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  }
}
